{
  "gateway": {
    "base_url": "http://127.0.0.1:10009/v1",
    "model": "ling-3.0-flash-int4",
    "max_tokens": 4096,
    "temperature": 0,
    "enable_thinking": false,
    "system_prompt_file": "../prompts/file_agent.txt"
  },
  "http": {
    "timeout_seconds": 300,
    "connect_timeout_seconds": 30,
    "max_body_bytes": 2097152,
    "max_error_body_bytes": 4096,
    "verify_peer": true,
    "verify_host": true
  },
  "network": {
    "credentials": {}
  },
  "context": {
    "window_tokens": 262144,
    "safety_margin_tokens": 8192,
    "compaction_trigger_percent": 80,
    "compaction_target_percent": 60
  },
  "files": {
    "max_list_entries": 16,
    "max_read_bytes": 65536,
    "max_write_bytes": 131072
  },
  "process": {
    "default_timeout_ms": 300000,
    "max_output_bytes": 262144,
    "max_read_bytes": 65536
  },
  "run": {
    "max_model_calls": 24,
    "max_tool_calls": 20,
    "max_model_retries": 2
  },
  "session": {
    "directory": "../.dagent/sessions",
    "record_payloads": true,
    "max_inline_payload_bytes": 4096,
    "redact_fields": ["api_key", "authorization", "token"]
  },
  "progress": {
    "interval_ms": 1000
  },
  "permissions": "auto"
}
