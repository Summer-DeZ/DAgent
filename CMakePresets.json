{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DAGENT_DEV_HOME": "${sourceDir}/home"
      }
    },
    {
      "name": "win-dev",
      "description": "Windows development configuration (MSVC + vcpkg; pass -DCMAKE_TOOLCHAIN_FILE on the command line)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/win-dev",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DAGENT_DEV_HOME": "${sourceDir}/home",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "win-dev", "configurePreset": "win-dev" }
  ]
}
