# DAgent 环境变量样例：复制为 .env.dev（开发用）或 .env 后填入真实值。
# .env 与 .env.* 均被 .gitignore 排除（本文件除外），真实密钥不会进仓库。
#
# 格式：KEY=VALUE；# 开头为注释；值可用单引号或双引号包裹；
# 进程里已存在的同名环境变量优先，文件中的值不会覆盖它。
#
# 这里只放密钥与本机相关的开关。模型、地址等写在配置文件里，由配置按变量名引用密钥：
#   "gateway": {
#     "base_url": "https://api.deepseek.com/v1",
#     "model": "deepseek-chat",
#     "api_key_env": "DEEPSEEK_API_KEY"
#   }

# ---- 模型服务密钥 ----
DEEPSEEK_API_KEY=sk-0000000000000000000000000000000000

# ---- 可选 ----
# 日志级别，格式见 docs/next-to-do/02-log.md，例：debug 或 net=trace,info
# DAGENT_LOG=info
