# Install resources in the current home layout without overwriting user files.
set(source "@CMAKE_SOURCE_DIR@/home")
set(destination "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
file(GLOB_RECURSE resources RELATIVE "${source}"
    "${source}/config/*.json" "${source}/config/*.lock" "${source}/prompts/*" "${source}/agents/*"
    "${source}/skills/*" "${source}/themes/*")
foreach(resource IN LISTS resources)
    if(resource STREQUAL "config/models.json" OR resource STREQUAL "config/mcp.json")
        continue()
    endif()
    set(target "${resource}")
    string(REPLACE ".example.json" ".json" target "${target}")
    if(NOT EXISTS "${destination}/${target}")
        get_filename_component(parent "${destination}/${target}" DIRECTORY)
        file(MAKE_DIRECTORY "${parent}")
        configure_file("${source}/${resource}" "${destination}/${target}" COPYONLY)
        if("@CMAKE_SYSTEM_NAME@" STREQUAL "Linux" AND
           (target STREQUAL "config/models.json" OR target STREQUAL "config/mcp.json"))
            file(CHMOD "${destination}/${target}" PERMISSIONS OWNER_READ OWNER_WRITE)
        elseif("@CMAKE_SYSTEM_NAME@" STREQUAL "Windows" AND
               (target STREQUAL "config/models.json" OR target STREQUAL "config/mcp.json"))
            file(TO_NATIVE_PATH "${destination}/${target}" native_target)
            execute_process(COMMAND icacls "${native_target}" /inheritance:r /grant:r
                "*S-1-5-32-544:F" "*S-1-5-18:F" "$ENV{USERNAME}:F"
                RESULT_VARIABLE code OUTPUT_QUIET ERROR_VARIABLE icacls_error)
            if(NOT code EQUAL 0)
                message(FATAL_ERROR "cannot set a private ACL on ${destination}/${target}: ${icacls_error}")
            endif()
        endif()
    endif()
endforeach()

# Generate for the final executable path, excluding the package staging root.
if("@CMAKE_SYSTEM_NAME@" STREQUAL "Linux")
    set(DAGENT_BACKEND_PATH "${CMAKE_INSTALL_PREFIX}/dagent-backend")
    file(MAKE_DIRECTORY "${destination}/libexec")
    configure_file("@CMAKE_SOURCE_DIR@/cmake/dagent.apparmor.in"
        "${destination}/libexec/dagent.apparmor" @ONLY)
endif()
